# Copy to .env (not committed) and fill in. Vite+ loads .env, .env.local, .env.<mode> and
# .env.<mode>.local; real environment variables override them.

# --- Extension (build time) -------------------------------------------------------------

# Pages that take part in mirroring: Chrome match patterns, separated by commas or spaces.
# The build writes them into the manifest's content_scripts.matches, and the background
# worker accepts tabs that match them the same way Chrome does: the scheme counts, a port
# counts only if given (":*" for any), and the path must be "/*". "*.example.com" also
# covers its subdomains. Unset: local dev servers only (http://localhost/*,
# http://127.0.0.1/*).
VITE_TARGET_MATCHES=http://localhost/*, http://127.0.0.1/*, https://dev.example.com/*

# --- End-to-end tests (npm run test:e2e) ------------------------------------------------
# Only E2E_URL is required. Command-line flags override these:
#   --url=<url> --browser=<path> --headed --scenario=<a,b> --size=<WxH> --timeout=<ms>

# The page to test, with the extension mirroring between its tabs. Must be covered by
# VITE_TARGET_MATCHES. Only its host is printed.
E2E_URL=https://dev.example.com/games/some-game/

# Browser that loads an unpacked extension from the command line: Microsoft Edge or
# Chromium (branded Google Chrome ignores --load-extension). Default: Edge if installed.
# E2E_BROWSER=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe

# Run without windows (default true). --headed shows them.
# E2E_HEADLESS=true

# Scenarios to run, comma-separated (default: all). See e2e/scenarios.mjs.
# E2E_SCENARIOS=extension-loads,click,size-mismatch,text,same-window

# Viewport of the test windows, and of the smaller one in size-mismatch.
# E2E_WINDOW_SIZE=1280x720
# E2E_SMALL_WINDOW_SIZE=960x540

# Time limit for each wait, and extra settle time after a page is ready (ms).
# E2E_TIMEOUT_MS=30000
# E2E_SETTLE_MS=1500

# The built extension to load, and where failure screenshots go.
# E2E_EXTENSION_DIR=dist
# E2E_OUTPUT_DIR=e2e/output

# Page elements the scenarios use.
# E2E_CLICK_TEXT=START
# E2E_TOGGLE_SELECTOR=.tp-toggle-btn
# E2E_TEXT_FIELD_SELECTOR=input.tp-txtv_i
